APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Phase 3 — Identity privacy (NID handling)
# ---------------------------------------------------------------------------
# NID_HMAC_KEY is a 256-bit key, INDEPENDENT of APP_KEY, used only for the
# keyed HMAC-SHA256 lookup hash over normalized identity numbers.
#
# Generate one with:
#     php -r "echo base64_encode(random_bytes(32));"
#
# The real value belongs ONLY in your local .env (which is git-ignored).
# Never commit, print or log it. Leave this placeholder as-is.
NID_HMAC_KEY=

# HMAC key generation stamp. Increment when rotating NID_HMAC_KEY.
NID_HMAC_KEY_VERSION=1

# Key generations still honoured for lookup during a rotation window.
NID_HMAC_KEY_ACCEPTED_VERSIONS=1

# The OUTGOING key, set only while a rotation is in flight.
# NID_HMAC_PREVIOUS_KEY=

# When true, identity operations fail closed if NID_HMAC_KEY is absent.
# This does NOT block the public demo pages or Phase 1/2 auth flows.
NID_FAIL_CLOSED=true

# ---------------------------------------------------------------------------
# Phase 4 — Presentation Demo Mode
# ---------------------------------------------------------------------------
# Enables the one-click "Enter demo panel" shortcuts on the Welcome page (/).
#
# Default is FALSE. Demo Mode additionally requires APP_ENV to be `local` or
# `testing`, so setting this to true in a production .env has no effect.
#
# Demo Mode NEVER grants a role, switches the current user's roles, or bypasses
# EnsureRole / policies / NID privacy. It only signs the browser in as a
# dedicated, pre-seeded DEVELOPMENT demo account through the normal login stack,
# so you still see exactly what that role is permitted to see.
LANDTECH_DEMO_MODE=false

# Optional password applied to every seeded demo account.
#
# LEAVE THIS UNSET for normal use: the seeder then generates a random, unusable
# password for each demo account, which is never printed or displayed. Demo Mode
# does not need a password because it authenticates the demo account directly.
#
# Set it ONLY if you want to log into a demo account manually by typing
# credentials. Any value you choose here is a DEVELOPMENT credential and must
# never be used for a real account or committed to version control.
# LANDTECH_DEMO_PASSWORD=
